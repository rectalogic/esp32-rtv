{
    "lsp": {
        "clangd": {
            "binary": {
                "path": "/usr/bin/clangd",
                "arguments": [
                    // XXX need to change the directory when the hash changes
                    "--compile-commands-dir=./target/xtensa-esp32s3-espidf/release/build/esp-idf-sys-a445e79b671646ac/out/build/"
                ]
            }
        },
        "rust-analyzer": {
            "initialization_options": {
                "cargo": {
                    "allTargets": false,
                    "target": "xtensa-esp32s3-espidf",
                    "extraEnv": {
                        "RUSTUP_TOOLCHAIN": "esp"
                    }
                },
                "server": {
                    "extraEnv": {
                        "RUSTUP_TOOLCHAIN": "stable"
                    }
                },
                "check": {
                    "extraEnv": {
                        "RUSTUP_TOOLCHAIN": "esp"
                    }
                }
            }
        }
    }
}
