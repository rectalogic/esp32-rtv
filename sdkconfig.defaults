# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# You might have to increase this further if you allocate large stack variables in the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# The Rust esp-idf-hal crate always compiles its legacy `i2c` module, which pulls the
# legacy I2C driver (driver/i2c/i2c.c) into the link even though it is never used.
# Its startup constructor then aborts because the new I2C driver (i2c_master, used by
# esp_board_manager's periph_i2c) is also linked. This app never touches the legacy
# I2C API, so skip that link-time conflict check.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

# You might have to increase this further if you spawn your own Rust threads
# that allocate large stack variables; or better yet - use
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Memory-map the LittleFS video partition (joltwallet/littlefs).
CONFIG_LITTLEFS_MMAP_PARTITION=y

# BlueTooth for wifi provisioning
CONFIG_BT_ENABLED=y
CONFIG_NIMBLE_ENABLED=y

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Put WiFi/LWIP buffer pools in PSRAM to keep SRAM free for LCD SPI.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Move WiFi/lwIP/BT static .bss (net80211, pp, lwip, bt) to PSRAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Software H.264 decode (tinyh264) of 320x240@15fps is close to a full ESP32-S3
# core; with the decoder, audio, and video render sharing a core the render
# starves (watchdog on CPU1 / "Render too slow"). Dual-task mode splits decode
# across both cores (helper task on core 1) so no single core saturates.
CONFIG_ESP_H264_DUAL_TASK=y
CONFIG_ESP_H264_DUAL_TASK_CORE=1
CONFIG_ESP_H264_DUAL_TASK_PRIORITY=17

#
# ESP Player: audio + video (MP4 A/V)
#
CONFIG_ESP_PLAYER_ENABLE_AUDIO=y
CONFIG_ESP_PLAYER_ENABLE_VIDEO=y
CONFIG_ESP_PLAYER_ENABLE_FILE_IO=y
CONFIG_ESP_PLAYER_ENABLE_HTTP_IO=y
CONFIG_ESP_PLAYER_ENABLE_HLS_IO=n

#
# Extractor (esp_extractor): MP4/TS container
#
CONFIG_EXTRACTOR_CUSTOM_SUPPORT=n
CONFIG_AUDIO_ES_EXTRACTOR_SUPPORT=n
CONFIG_WAV_EXTRACTOR_SUPPORT=n
CONFIG_MP4_EXTRACTOR_SUPPORT=y
CONFIG_TS_EXTRACTOR_SUPPORT=y
CONFIG_OGG_EXTRACTOR_SUPPORT=n
CONFIG_AVI_EXTRACTOR_SUPPORT=n
CONFIG_CAF_EXTRACTOR_SUPPORT=n
CONFIG_FLV_EXTRACTOR_SUPPORT=n

#
# Video decoder (esp_video_codec): H.264 only
#
CONFIG_VIDEO_DECODER_SW_H264_SUPPORT=y
CONFIG_VIDEO_DECODER_SW_MJPEG_SUPPORT=n

#
# Audio decoder (esp_audio_codec): AAC for MP4 audio track
#
CONFIG_AUDIO_DECODER_MP3_SUPPORT=n
CONFIG_AUDIO_DECODER_AAC_SUPPORT=y
CONFIG_AUDIO_DECODER_G711_SUPPORT=n
CONFIG_AUDIO_DECODER_G722_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_DECODER_FLAC_SUPPORT=n
CONFIG_AUDIO_DECODER_VORBIS_SUPPORT=n
CONFIG_AUDIO_DECODER_OPUS_SUPPORT=n
CONFIG_AUDIO_DECODER_ADPCM_SUPPORT=n
CONFIG_AUDIO_DECODER_ALAC_SUPPORT=n
CONFIG_AUDIO_DECODER_PCM_SUPPORT=n
CONFIG_AUDIO_DECODER_SBC_SUPPORT=n
CONFIG_AUDIO_DECODER_LC3_SUPPORT=n

CONFIG_AUDIO_SIMPLE_DEC_WAV_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_M4A_SUPPORT=y
CONFIG_AUDIO_SIMPLE_DEC_TS_SUPPORT=y
CONFIG_AUDIO_SIMPLE_DEC_OGG_SUPPORT=n

CONFIG_AUDIO_ENCODER_AAC_SUPPORT=n
CONFIG_AUDIO_ENCODER_G711_SUPPORT=n
CONFIG_AUDIO_ENCODER_G722_SUPPORT=n
CONFIG_AUDIO_ENCODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_ENCODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_ENCODER_OPUS_SUPPORT=n
CONFIG_AUDIO_ENCODER_ADPCM_SUPPORT=n
CONFIG_AUDIO_ENCODER_ALAC_SUPPORT=n
CONFIG_AUDIO_ENCODER_PCM_SUPPORT=n
CONFIG_AUDIO_ENCODER_SBC_SUPPORT=n
CONFIG_AUDIO_ENCODER_LC3_SUPPORT=n

CONFIG_ESP_VIDEO_RENDER_TEXT_WIDGET_SUPPORT=y
